# ==============================================================
# FINCRED PRODUCTION & DEPLOYMENT ENVIRONMENT CONFIGURATION
# ==============================================================
# Copy this file to .env and replace placeholder values with your
# real credentials. NEVER commit real secrets to GitHub.

# --------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# --------------------------------------------------------------
# The port the Node.js server will listen on. Usually set dynamically by hosting platforms (Render, Railway, Cloud Run).
PORT=3000

# Node environment: 'development' or 'production'
NODE_ENV=production

# Public base URL of your deployed application (without trailing slash)
# Example: https://fincred.yourdomain.com
APP_BASE_URL=https://your-domain.com

# CORS Allowed Origins. Use '*' for open access, or comma-separated origins
CORS_ORIGIN=*

# --------------------------------------------------------------
# 2. ADMIN AUTHENTICATION
# --------------------------------------------------------------
# Admin portal login username
ADMIN_USERNAME=FIN-CRED

# Admin portal login password (MUST be changed in production)
ADMIN_PASSWORD=YourStrongAdminPasswordHere#123

# Secret key used for signing/validating admin sessions
ADMIN_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

# --------------------------------------------------------------
# 3. FIREBASE / FIRESTORE DATABASE CONFIGURATION
# --------------------------------------------------------------
# Firebase Project credentials for database persistence (customers, loans, referrals)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=AIzaSyYourApiKeyHere
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Alternatively, provide the complete JSON configuration as a single-line string:
# FIREBASE_CONFIG={"projectId":"your-project","apiKey":"...","authDomain":"...","firestoreDatabaseId":"(default)"}

# --------------------------------------------------------------
# 4. STORAGE / FILE UPLOADS
# --------------------------------------------------------------
# Path where document uploads are stored (defaults to public/uploads)
UPLOADS_DIR=./public/uploads

# --------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (CLIENT-SIDE VITE VARIABLES)
# --------------------------------------------------------------
# If frontend is deployed separately from backend (e.g. Vercel frontend + Render backend),
# specify the full URL to your backend API.
# Leave EMPTY if frontend and backend are served from the same domain (recommended).
VITE_API_BASE_URL=

# Public URL used for client-side referral links and WhatsApp sharing
VITE_APP_BASE_URL=https://your-domain.com
